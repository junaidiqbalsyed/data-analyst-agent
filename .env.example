# Copy this file to .env and fill in your own values:
#   cp .env.example .env
#
# These 3 are the only required variables — everything else in the app
# (models per agent role, ports, etc.) is derived from these or has a
# sensible built-in default.

# Base URL of your OpenAI-SDK-compatible endpoint (Azure AI Foundry's
# /openai/v1/ path, OpenAI itself, or any other OpenAI-compatible gateway).
# Must include the /openai/v1/ suffix for Azure endpoints.
LLM_BASE_URL=https://integrate.api.nvidia.com/v1

# API key for the endpoint above.
LLM_API_KEY=your-api-key-here

# Default model deployment name used by every agent unless overridden below.
LLM_MODEL=openai/gpt-oss-120b

# Optional: give specific agent roles a different model (same endpoint/key)
# instead of falling back to LLM_MODEL above. JSON object, role -> model.
# Leave unset/commented to use LLM_MODEL for every agent.
#
# Every question goes through 3 roles by default (see app/orchestration):
# router (classify), conversational (chitchat), and fast-analyst (the
# actual SQL + answer agent) — these are the ones worth tuning for latency.
# LLM_MODEL_OVERRIDES={"router": "gpt-5.4-nano", "conversational": "gpt-5.4-nano", "fast-analyst": "gpt-5.4-mini"}
#
# The full multi-level crew (app/crews/orchestrator_crew.py) is not the
# default path — see app/orchestration/fast_path.py — but is still in the
# codebase and still honors overrides for its own roles if it's ever
# invoked directly: chief-orchestrator, orchestrator-planning,
# liaison-quant, liaison-discovery, liaison-insight, quant-manager,
# quant-planning, data-analyst, schema-explorer, dictionary-writer,
# insight-writer, report-critic, memory-analysis.
